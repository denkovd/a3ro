{
  "name": "a3ro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:research": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:security": "node --test tests/api-security.test.mjs && npm --prefix backend run test:security",
    "test:optimization": "node --test tests/optimization.test.mjs",
    "test:landing": "node --test tests/landing-sequence.test.mjs",
    "refresh:australia-capital": "node --use-system-ca scripts/refresh-australia-capital.mjs",
    "refresh:capital": "node --use-system-ca scripts/refresh-cost-of-capital.mjs",
    "publish:capital": "node --use-system-ca --import ./backend/node_modules/tsx/dist/loader.mjs backend/scripts/publish-capital.ts",
    "test:capital": "node --test tests/cost-of-capital.test.mjs tests/australia-capital.test.mjs",
    "test:oil": "node --test tests/oil-intelligence.test.mjs",
    "test:gold": "node --test tests/gold-intelligence.test.mjs",
    "test:bull": "node --test tests/bull-columns.test.mjs tests/bull-chart.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.3.0",
    "lightweight-charts": "^5.3.0",
    "next": "15.5.29",
    "pg": "^8.11.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
